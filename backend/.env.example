# Copie ce fichier en ".env" (meme dossier) et remplace les valeurs par tes cles privees. Ne jamais le commiter.
PLANTNET_API_KEY=colle-ta-cle-ici

# AI Lab - modele de langage (choisis UNE option ; sans rien, Ollama local est detecte automatiquement)
# Gratuit : cle Groq sur https://console.groq.com/keys
# GAIA_LLM_PROVIDER=groq
# GAIA_LLM_API_KEY=gsk_...
# Gratuit : jeton Hugging Face (https://huggingface.co/settings/tokens)
# GAIA_LLM_PROVIDER=huggingface
# GAIA_LLM_API_KEY=hf_...
# Payant : Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Comptes - "mot de passe oublie" : envoi du code par e-mail (sans rien, le code s'affiche dans la console du serveur)
# GAIA_SMTP_HOST=smtp.gmail.com
# GAIA_SMTP_PORT=587
# GAIA_SMTP_USER=ton-adresse@gmail.com
# GAIA_SMTP_PASSWORD=mot-de-passe-d-application
# GAIA_SMTP_FROM=GAIA <ton-adresse@gmail.com>

# Comptes - code par WhatsApp pour les numeros de telephone (WhatsApp Business Cloud API de Meta)
# GAIA_WA_TOKEN=
# GAIA_WA_PHONE_ID=identifiant-du-numero-expediteur
# GAIA_WA_TEMPLATE=gaia_code
# GAIA_WA_LANG=fr

# Copy this file to backend/.env (never commit .env) and fill in ONE free key.
# Smart irrigation agent on a free hosted model:
#   Gemini (Google AI Studio, free tier, available in Tunisia): https://aistudio.google.com/apikey
#   Groq (free tier): https://console.groq.com/keys
GAIA_LLM_PROVIDER=gemini
GAIA_LLM_API_KEY=
# Optional: another free model of the same provider
# GAIA_FREE_MODEL=gemini-3.5-flash

# Optional, paid: Claude answers instead when this is set
# ANTHROPIC_API_KEY=
